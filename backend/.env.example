# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=social-media-hub-super-secret-key-2026

# SQLite Database Path
DB_PATH=./data/database.sqlite

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook App Credentials
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/auth/facebook/callback

# Instagram Basic Display / Graph API
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/auth/instagram/callback

# Twitter / X API v2
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:3001/api/auth/twitter/callback

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

# TikTok API for Developers
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3001/api/auth/tiktok/callback

# YouTube / Google OAuth 2.0
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback

# Snapchat Marketing / Login Kit
SNAPCHAT_CLIENT_ID=your_snapchat_client_id
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret
SNAPCHAT_REDIRECT_URI=http://localhost:3001/api/auth/snapchat/callback

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Email 2FA (SMTP Server Settings) ─────────────────────────────────────────
# Leave empty for console dev logging, or fill with Gmail / SendGrid / Resend credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="SocialHub Security" <security@socialhub.com>

