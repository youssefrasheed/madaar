# ==============================================================================
# Madaar Platform - Production Environment Variables
# ==============================================================================

# Server Environment
PORT=3001
NODE_ENV=production

# Security - Change this to a secure 64-character random string in production!
JWT_SECRET=replace_with_a_very_strong_random_secret_string_minimum_32_characters

# SQLite Database Location
DB_PATH=./data/database.sqlite

# Google Gemini AI API (Required for AI generation, scheduling & post enhancement)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Email 2FA & Verification (SMTP Settings) ─────────────────────────────────
# For production OTP emails (Gmail App Password, Brevo, SendGrid, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Madaar Security" <security@madaar.com>

# ─── Social Media Platform OAuth 2.0 Credentials (Optional / As needed) ───────
# Fill these in when connecting live developer apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://YOUR_SUBDOMAIN/api/auth/facebook/callback

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR_SUBDOMAIN/api/auth/instagram/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://YOUR_SUBDOMAIN/api/auth/twitter/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR_SUBDOMAIN/api/auth/linkedin/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR_SUBDOMAIN/api/auth/tiktok/callback

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://YOUR_SUBDOMAIN/api/auth/youtube/callback

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=https://YOUR_SUBDOMAIN/api/auth/snapchat/callback
